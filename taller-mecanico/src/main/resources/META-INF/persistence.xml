<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="Programacion2">

        <class>com.programacion2.dominio.Cliente</class>
        <class>com.programacion2.dominio.Vehiculo</class>
        <class>com.programacion2.dominio.OrdenDeTrabajo</class>

        <exclude-unlisted-classes/>

        <properties>

            <property
                name="javax.jdo.option.ConnectionDriverName"
                value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>

            <!--
                URL, usuario y contraseña de la base NO se escriben aca:
                se leen de application.properties (o de variables de entorno)
                en PersistenciaConfig.
            -->

            <property
                name="datanucleus.schema.autoCreateAll"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>
